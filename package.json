{
  "name": "promax-cabinet-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Persian-first cabinet planning and cut-list desktop application",
  "author": "Pro.Max Workshop",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "electron electron/main.cjs",
    "test": "node --test",
    "preview": "vite preview --host 0.0.0.0",
    "desktop:dev": "concurrently -k \"npm:dev\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron electron/main.cjs\"",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:win:portable": "npm run build && electron-builder --win portable --publish never"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "build": {
    "appId": "com.promax.cabinetstudio",
    "productName": "Pro.Max Cabinet Studio",
    "copyright": "Copyright © 2026 Pro.Max Workshop",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Pro.Max-Cabinet-Studio-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pro.Max Cabinet Studio",
      "uninstallDisplayName": "Pro.Max Cabinet Studio ${version}",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "artifactName": "Pro.Max-Cabinet-Studio-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Pro.Max-Cabinet-Studio-${version}-Portable.${ext}"
    }
  }
}
